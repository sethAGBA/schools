# Domaine public (Caddy/Let's Encrypt)
PUBLIC_API_HOST=api.example.com

# Image Docker de l'API (à remplacer par ton registry)
API_IMAGE=ghcr.io/ORG/school-manager-api:latest

# Port interne exposé par l'API dans le container
API_PORT=8080

# Chaîne de connexion PostgreSQL (idéalement DB managée + allowlist IP du VPS)
# Exemple: Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true
POSTGRES_CONNECTION_STRING=

# Clés/secrets (exemples)
JWT_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=

# Environnement applicatif
ASPNETCORE_ENVIRONMENT=Production

